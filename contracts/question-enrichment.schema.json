{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "primarySkill", "secondarySkills", "difficulty", "tags", "idealAnswer"],
  "properties": {
    "type": {"enum": ["TECHNICAL", "BEHAVIORAL"]},
    "primarySkill": {"type": ["string", "null"]},
    "secondarySkills": {"type": "array", "uniqueItems": true, "maxItems": 10, "items": {"type": "string"}},
    "difficulty": {"enum": ["EASY", "MEDIUM", "HARD", null]},
    "tags": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}},
    "idealAnswer": {"type": "string", "minLength": 50, "maxLength": 2000}
  }
}
